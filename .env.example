ASPNETCORE_ENVIRONMENT=Development
SQLSERVER_CONNECTION_STRING=Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=InternshipJobManagementDb;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True
REDIS_CONNECTION_STRING=localhost:6379
JWT_SECRET=change-this-to-a-very-long-random-production-secret-at-least-32-chars
JWT_ISSUER=InternshipJobManagement
JWT_AUDIENCE=InternshipJobManagementClient
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
